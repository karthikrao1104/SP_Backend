# ============================================================
# Required environment variables for the Student Prediction
# Backend on Render (or any other production host).
#
# Copy this file to .env for local development.
# NEVER commit the actual .env file to Git.
# ============================================================

# ----------------------------------------------------------
# Django core
# ----------------------------------------------------------

# Generate a secure key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Set to False in production. Set to True only for local debugging.
DJANGO_DEBUG=False

# Comma-separated list of hostnames that Django will serve.
# Plain hostnames only – no https:// prefix, no trailing slashes.
DJANGO_ALLOWED_HOSTS=sp-backend-2-5jw2.onrender.com,localhost,127.0.0.1

# ----------------------------------------------------------
# Database (optional – leave unset to use SQLite locally)
# ----------------------------------------------------------

# Render provides this automatically when you attach a PostgreSQL database.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ----------------------------------------------------------
# Optional tuning
# ----------------------------------------------------------

# Django log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=WARNING

